# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Match Black's line length so editors wrap/ruler at the same place.
[*.py]
max_line_length = 88

# YAML, JSON, and TOML conventionally use 2-space indentation.
[*.{yml,yaml,json,toml}]
indent_size = 2

# Markdown uses trailing whitespace for hard line breaks, don't strip it
# (mirrors the trailing-whitespace pre-commit hook's --markdown-linebreak-ext).
[*.md]
trim_trailing_whitespace = false
